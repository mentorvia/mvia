# Copy this file to ".env" for local development and fill in values.
# NEVER commit your real .env file. The real values on Render are set in its dashboard.

DJANGO_SECRET_KEY=some-long-random-string-for-local-use
DJANGO_DEBUG=true

# Leave these blank until you set up the real services.
# When blank, the app stays in safe placeholder mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL=hello@mvia.in
DEFAULT_PLATFORM_FEE=100
